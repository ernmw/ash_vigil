    "speaker_race": "",
    "speaker_class": "",
    "speaker_faction": "",
    "speaker_cell": "",
    "player_faction": "",
    "sound_path": "",
    "text": "Barnand hid the orb outside the tower in a mucksponge.",
    "filters": [],
    "script_text": ""
  },
